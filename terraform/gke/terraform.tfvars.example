# Example Terraform variables file for GKE cluster with NGINX Ingress
# Copy this file to terraform.tfvars and update the values

# Required: Your GCP project ID
project_id = "your-gcp-project-id"

# GCP region for the cluster
region = "us-central1"

# Optional: GCP zone for zonal cluster (leave empty for regional cluster)
# zone = "us-central1-a"

# Cluster configuration
cluster_name       = "my-gke-cluster"
kubernetes_version = "1.36"

# Default node pool configuration
min_node_count  = 1
max_node_count  = 3
machine_type    = "e2-medium"
disk_size_gb    = 50

# Monitoring node pool configuration
monitoring_min_node_count = 1
monitoring_max_node_count = 2
monitoring_machine_type   = "e2-standard-4"
monitoring_disk_size_gb   = 50

# Cluster autoscaling
enable_autoscaling  = true
autoscaling_profile = "OPTIMIZE_UTILIZATION"

vpc_name = "default"
